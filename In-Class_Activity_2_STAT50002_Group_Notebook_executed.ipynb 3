   "source": [
    "# Q2 — Exam Score Comparison — Grouped Bar Chart\n",
    "tests = [1, 2, 3, 4, 5]\n",
    "class_a = [82, 78, 68, 70, 65]\n",
    "class_b = [85, 80, 74, 76, 61]\n",
    "\n",
    "x = np.arange(len(tests))\n",
    "width = 0.35\n",
    "\n",
    "plt.rcdefaults()\n",
    "plt.figure(figsize=(8, 5))\n",
    "\n",
    "plt.bar(x - width/2, class_a, width, label='Class A')\n",
    "plt.bar(x + width/2, class_b, width, label='Class B')\n",
    "\n",
    "plt.title('Average Exam Scores by Test')\n",
    "plt.xlabel('Test Number')\n",
    "plt.ylabel('Average Score')\n",
    "plt.xticks(x, tests)\n",
    "plt.ylim(0, 100)\n",
    "plt.legend(loc='upper right')\n",
    "plt.grid(axis='y', linestyle='--', alpha=0.6)\n",
    "\n",
    "plt.show()\n"
   ],
