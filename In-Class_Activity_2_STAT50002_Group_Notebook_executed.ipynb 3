    "# Q3 — City Temperature Comparison\n",
    "days = [1, 2, 3, 4, 5, 6, 7]\n",
    "city_1 = [20, 21, 19, 22, 23, 24, 25]\n",
    "city_2 = [12, 13, 10, 15, 17, 15, 16]\n",
    "\n",
    "plt.rcdefaults()\n",
    "plt.rcParams.update({\n",
    "    'lines.linewidth': 2.5,\n",
    "    'axes.titlesize': 16,\n",
    "    'axes.labelsize': 12,\n",
    "    'xtick.labelsize': 10,\n",
    "    'ytick.labelsize': 10,\n",
    "    'axes.grid': True,\n",
    "    'grid.linestyle': '--'\n",
    "})\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "\n",
    "plt.plot(days, city_1, marker='o', label='City 1')\n",
    "plt.plot(days, city_2, marker='s', label='City 2')\n",
    "\n",
    "plt.title('City Temperature Comparison Over 7 Days')\n",
    "plt.xlabel('Day')\n",
    "plt.ylabel('Temperature (°C)')\n",
    "plt.xticks(days)\n",
    "\n",
    "plt.legend(title='Cities', loc='upper left', fontsize=10, title_fontsize=11)\n",
    "plt.show()\n"
