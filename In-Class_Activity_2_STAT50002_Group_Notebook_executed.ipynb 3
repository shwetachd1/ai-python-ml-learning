   "source": [
    "# Q1 — Monthly Weather Subplots\n",
    "\n",
    "months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun']\n",
    "temperature = [2, 4, 8, 14, 18, 22]\n",
    "rainfall = [60, 55, 70, 65, 75, 90]\n",
    "humidity = [80, 78, 75, 72, 70, 68]\n",
    "\n",
    "plt.rcdefaults()\n",
    "\n",
    "fig = plt.figure(figsize=(15, 4))\n",
    "\n",
    "plt.style.use('ggplot')\n",
    "plt.subplot(1, 3, 1)\n",
    "plt.plot(months, temperature, marker='o', label='Temperature')\n",
    "plt.title('Monthly Temperature')\n",
    "plt.xlabel('Month')\n",
    "plt.ylabel('Temperature (°C)')\n",
    "plt.xticks(rotation=45, size=9)\n",
    "\n",
    "plt.style.use('fivethirtyeight')\n",
    "plt.subplot(1, 3, 2)\n",
    "plt.plot(months, rainfall, marker='o', label='Rainfall')\n",
    "plt.title('Monthly Rainfall')\n",
    "plt.xlabel('Month')\n",
    "plt.ylabel('Rainfall (mm)')\n",
    "plt.xticks(rotation=45, size=9)\n",
    "\n",
    "plt.style.use('default')\n",
    "plt.subplot(1, 3, 3)\n",
    "plt.plot(months, humidity, marker='o', label='Humidity')\n",
    "plt.title('Monthly Humidity')\n",
    "plt.xlabel('Month')\n",
    "plt.ylabel('Humidity (%)')\n",
    "plt.xticks(rotation=45, size=9)\n",
    "plt.grid(True)\n",
    "\n",
    "plt.suptitle('Monthly Weather Averages: January to June', fontsize=16)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ],
